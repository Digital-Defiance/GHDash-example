{
  "name": "ghdash-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An EmDash blog that runs entirely on GitHub Pages, with content stored as JSON in this repo.",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "db": "ghdash-pages build-db",
    "build": "npm run db && ghdash-pages fetch-browser-api && ghdash-pages publish-due && ghdash-pages studio-assets && ghdash-pages copy-media && astro build && ghdash-pages finish && pagefind --site dist/client",
    "preview": "npx serve dist/client",
    "export-content": "ghdash-pages export-content data.db content",
    "test:e2e": "playwright test",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "7.0.0",
    "@emdash-cms/admin": "https://github.com/Digital-Defiance/ghdash/releases/download/pages-v0.6.0/emdash-cms-admin-1.5.0.tgz",
    "@emdash-cms/plugin-color": "^0.2.1",
    "@emdash-cms/plugin-embeds": "^0.1.59",
    "@emdash-cms/plugin-field-kit": "^0.1.3",
    "@sqlite.org/sqlite-wasm": "3.50.4-build1",
    "astro": "7.3.2",
    "emdash": "1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@digital-defiance/ghdash-pages": "https://github.com/Digital-Defiance/ghdash/releases/download/pages-v0.12.0/digital-defiance-ghdash-pages-0.7.0.tgz",
    "@emdash-cms/plugin-webhook-notifier": "^0.2.3",
    "@playwright/test": "^1.63.0",
    "lightningcss": "1.33.0",
    "pagefind": "^1.6.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "overrides": {
    "@emdash-cms/admin": "https://github.com/Digital-Defiance/ghdash/releases/download/pages-v0.6.0/emdash-cms-admin-1.5.0.tgz"
  }
}
