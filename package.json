{
  "name": "ghdash-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An EmDash blog that runs entirely on GitHub Pages, with content stored as JSON in this repo.",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "db": "node scripts/build-db.mjs",
    "build": "npm run db && node scripts/studio-assets.mjs && astro build && node scripts/rebase-urls.mjs dist/client",
    "preview": "npx serve dist/client",
    "export-content": "node scripts/db-json.mjs export data.db content",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "7.0.0",
    "@emdash-cms/admin": "https://github.com/Digital-Defiance/ghdash/releases/download/pages-v0.1.0/emdash-cms-admin-1.5.0.tgz",
    "@sqlite.org/sqlite-wasm": "3.50.4-build1",
    "astro": "7.3.2",
    "emdash": "1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "lightningcss": "1.33.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "overrides": {
    "@emdash-cms/admin": "https://github.com/Digital-Defiance/ghdash/releases/download/pages-v0.1.0/emdash-cms-admin-1.5.0.tgz"
  }
}
