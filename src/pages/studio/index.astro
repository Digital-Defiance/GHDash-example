---
// The real EmDash admin, running in the browser with no server. Experimental: see SPEC.md Phase 2b.
export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Studio</title>
		<meta
			http-equiv="Content-Security-Policy"
			content="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.github.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
		/>
		<script is:inline src="/studio/paths.js"></script>
	</head>
	<body class="isolate">
		<div id="admin-root" class="min-h-screen"></div>
		<script>
			import "@digital-defiance/ghdash-pages/studio/boot.tsx";
		</script>
	</body>
</html>
