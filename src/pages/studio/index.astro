---
// The real EmDash admin, running in the browser with no server. Experimental: see SPEC.md Phase 2b.
export const prerender = true;
import { studioApiOrigin } from "@digitaldefiance/ghdash-pages/host";
import { getOAuth } from "../../utils/github-oauth.mjs";

const oauth = getOAuth();
const exchangeOrigin = oauth ? new URL(oauth.exchangeUrl).origin : "";
// The git host's API (api.github.com, gitlab.com or a self-managed GitLab) is where the studio commits.
const csp = `default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ${studioApiOrigin()}${exchangeOrigin ? ` ${exchangeOrigin}` : ""}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Studio</title>
		<meta http-equiv="Content-Security-Policy" content={csp} />
		{oauth && <meta name="studio-oauth" content={JSON.stringify(oauth)} />}
		<script is:inline src="/studio/paths.js"></script>
	</head>
	<body class="isolate">
		<div id="admin-root" class="min-h-screen"></div>
		<script>
			import "../../studio-plugins";
			import "../../studio-oauth";
			import "@digitaldefiance/ghdash-pages/studio/boot.tsx";
		</script>
	</body>
</html>
