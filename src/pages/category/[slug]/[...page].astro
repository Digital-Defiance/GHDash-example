---
export async function getStaticPaths() {
	const { getTaxonomyTerms, getEmDashCollection } = await import("emdash");
	const { PAGE_SIZE, pageCursors, pageParam } = await import("../../../utils/paginate");
	const terms = await getTaxonomyTerms("category");
	const paths = [];
	for (const t of terms) {
		const cursors = await pageCursors((cursor) =>
			getEmDashCollection("posts", { where: { category: t.slug }, orderBy: { published_at: "desc" }, limit: PAGE_SIZE, cursor }),
		);
		cursors.forEach((cursor, i) =>
			paths.push({ params: { slug: t.slug, page: pageParam(i + 1) }, props: { cursor, page: i + 1, totalPages: cursors.length } }),
		);
	}
	return paths;
}

import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { PAGE_SIZE } from "../../../utils/paginate";
import Pagination from "../../../components/Pagination.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const { cursor, page, totalPages } = Astro.props;
const {
	entries: posts,
	cacheHint,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: PAGE_SIZE,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={`${term.label} posts`} description={`All posts in ${term.label}`}>
	<header class="band intro">
		<div class="frame archive-intro">
			<div class="archive-intro__text">
				<p class="eyebrow">Category</p>
				<h1 class="intro__title">{term.label}</h1>
				<p class="intro__lead">
					{term.description || `Posts filed under ${term.label}, newest first.`}
				</p>
			</div>
			<a href="/posts" class="arrow-link">
				All posts
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14"></path>
					<path d="m12 5 7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			{
				filteredPosts.length > 0 ? (
					<>
						<div class="post-grid">
							{filteredPosts.map(({ post, tags }) => (
								<PostCard
									post={post}
									tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
								/>
							))}
						</div>
						<Pagination
							basePath={`/category/${term.slug}`}
							page={page}
							totalPages={totalPages}
						/>
					</>
				) : (
					<div class="empty-state">
						<h2 class="empty-state__title">
							Nothing here yet
						</h2>
						<p class="empty-state__text">
							{`No posts have been filed under ${term.label} so far.`}
						</p>
						<div class="empty-state__actions">
							<a
								href="/posts"
								class="btn btn--ghost"
							>
								Browse all posts
							</a>
						</div>
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.archive-intro {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		align-items: last baseline;
		justify-content: space-between;
		gap: var(--spacing-5) var(--spacing-10);
	}

	.archive-intro__text {
		min-width: 0;
	}
</style>
