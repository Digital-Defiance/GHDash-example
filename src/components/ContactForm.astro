---
interface Props {
	kind?: "form" | "issue";
	host?: "github" | "gitlab";
	hostUrl?: string;
	repo?: string;
	label?: string;
	endpoint?: string;
	subject?: string;
	turnstileSiteKey?: string;
}

const { kind = "form", host = "github", hostUrl = "https://gitlab.com", repo = "", label = "contact", endpoint = "", subject = "", turnstileSiteKey = "" } = Astro.props;
---

{kind === "issue" && host === "gitlab" ? (
	<form class="contact" method="get" action={`${hostUrl}/${repo}/-/issues/new`} target="_blank" rel="noopener">
		<p class="contact__note">
			Your message opens as a <strong>public</strong> GitLab issue on {repo}. You need a GitLab account, and anyone can read it. Don't include private details.
		</p>
		<label class="contact__field">
			<span>Subject</span>
			<input type="text" name="issue[title]" required maxlength="200" />
		</label>
		<label class="contact__field">
			<span>Message</span>
			<textarea name="issue[description]" required rows="6" maxlength="5000"></textarea>
		</label>
		<button type="submit" class="btn">Continue on GitLab</button>
	</form>
) : kind === "issue" ? (
	<form class="contact" method="get" action={`https://github.com/${repo}/issues/new`} target="_blank" rel="noopener">
		<p class="contact__note">
			Your message opens as a <strong>public</strong> GitHub issue on {repo}. You need a GitHub account, and anyone can read it. Don't include private details.
		</p>
		<input type="hidden" name="labels" value={label} />
		<label class="contact__field">
			<span>Subject</span>
			<input type="text" name="title" required maxlength="200" />
		</label>
		<label class="contact__field">
			<span>Message</span>
			<textarea name="body" required rows="6" maxlength="5000"></textarea>
		</label>
		<button type="submit" class="btn">Continue on GitHub</button>
	</form>
) : (
<form class="contact" method="post" action={endpoint} data-contact>
	{subject && <input type="hidden" name="subject" value={subject} />}
	<p class="contact__trap" aria-hidden="true">
		<label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
	</p>
	<label class="contact__field">
		<span>Name</span>
		<input type="text" name="name" required maxlength="200" autocomplete="name" />
	</label>
	<label class="contact__field">
		<span>Email</span>
		<input type="email" name="email" required maxlength="320" autocomplete="email" />
	</label>
	<label class="contact__field">
		<span>Message</span>
		<textarea name="message" required rows="6" maxlength="5000"></textarea>
	</label>
	{turnstileSiteKey && (
		<>
			<div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
			<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
		</>
	)}
	<button type="submit" class="btn">Send message</button>
	<p class="contact__status" role="status" aria-live="polite" data-contact-status></p>
</form>
)}

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>("form[data-contact]")) {
		const status = form.querySelector<HTMLElement>("[data-contact-status]")!;
		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
			button.disabled = true;
			status.textContent = "Sending…";
			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: { accept: "application/json" },
					body: new FormData(form),
				});
				const result = await response.json().catch(() => ({}));
				if (response.ok && result.ok !== false) {
					form.reset();
					status.textContent = "Thanks, your message was sent.";
				} else {
					status.textContent = result.error || "Sorry, that did not send. Please try again.";
				}
			} catch {
				status.textContent = "Sorry, that did not send. Please check your connection and try again.";
			}
			button.disabled = false;
		});
	}
</script>

<style>
	.contact {
		display: grid;
		gap: var(--spacing-4);
		max-width: 36rem;
	}
	.contact__note {
		margin: 0;
		color: var(--color-text-secondary);
	}
	.contact__trap {
		position: absolute;
		inset-inline-start: -10000px;
	}
	.contact__field {
		display: grid;
		gap: var(--spacing-2);
		font-weight: 500;
	}
	.contact input[type="text"],
	.contact input[type="email"],
	.contact textarea {
		padding: var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md, 8px);
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
	}
	.contact textarea:focus,
	.contact input:focus {
		outline: 2px solid transparent;
		border-color: var(--color-muted);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}
	.contact .btn {
		justify-self: start;
	}
</style>
